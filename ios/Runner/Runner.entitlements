<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.growdaily.v2.widget</string>
	</array>
	<!-- Push Notifications capability - the same single entitlement Xcode's
	     own "+ Capability > Push Notifications" button would add. "development"
	     here is standard for a single shared entitlements file: Xcode's
	     signing step re-resolves this against whichever provisioning profile
	     is actually in play at archive/export time (a distribution profile
	     yields a "production" aps-environment in the signed binary), so this
	     source value doesn't need to be flipped by hand for a release build. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links. Without this entitlement an https invite link just
	     opens Safari, and a growdaily:// link is worse still: messengers do
	     not linkify custom schemes at all, so a shared invite arrived as
	     untappable grey text and did nothing whatsoever for anyone who did
	     not already have the app.

	     Must stay in sync with THREE other places, or the link silently
	     degrades to opening the web page instead of the app:
	       - lib/core/constants/deep_links.dart  (linkHost)
	       - public/.well-known/apple-app-site-association  (appIDs / paths)
	       - firebase.json  (hosting: serves that file as application/json)

	     Note Apple fetches the association file through its own CDN, so a
	     freshly-changed host can take a few minutes to take effect, and
	     iOS caches it per-install — reinstalling the app is the reliable way
	     to re-test after changing it. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:grow-daily-339ef.web.app</string>
	</array>
	<!-- HealthKit capability - the same entitlement Xcode's "+ Capability >
	     HealthKit" button would add. Used read-only: HealthStepsService reads
	     the day's step total so a linked walking habit can complete itself.
	     The App ID on the developer portal must also have HealthKit enabled;
	     Xcode's automatic signing does that on the next archive. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<!-- Time Sensitive notifications - the same entitlement Xcode's
	     "+ Capability > Time Sensitive Notifications" button would add. No
	     Apple approval involved, unlike Critical Alerts. Lets a prayer-anchored
	     reminder (interruptionLevel timeSensitive, see NotificationService.
	     _habitReminderDetails) be delivered through Focus, Do Not Disturb and
	     Sleep on the phone and on a paired Apple Watch; without this key iOS
	     silently downgrades the level to active. Clock-time reminders keep
	     the default level. The App ID on the developer portal must also have
	     the capability enabled; Xcode's automatic signing does that on the
	     next archive, exactly as for HealthKit above. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Sign in with Apple - the same entitlement Xcode's "+ Capability >
	     Sign In with Apple" button would add. Not optional the moment the
	     auth screen offers Google: App Store Review Guideline 4.8 requires an
	     equivalent privacy-preserving login option wherever a third-party or
	     social login is offered, and Sign in with Apple is the one Apple
	     accepts. Without this key the ASAuthorization request fails
	     immediately at runtime with error 1000 (unknown), which reads like a
	     code bug and is not one.

	     Two things outside this file must also be true, and neither is
	     something the repo can do for itself:
	       - the App ID com.growdaily.v2 on the Apple Developer portal must
	         have the "Sign In with Apple" capability enabled (Xcode's
	         automatic signing does this on the next archive, exactly as it
	         does for HealthKit above);
	       - Firebase Console > Authentication > Sign-in method must have the
	         Apple provider enabled, or Firebase rejects the credential with
	         operation-not-allowed even though Apple returned a valid one. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
