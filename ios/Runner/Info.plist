<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Grow Daily</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Grow Daily</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>growdaily</string>
			</array>
		</dict>
		<!-- Google Sign-In callback. Google's SDK opens the account chooser in
		     an ASWebAuthenticationSession and hands the result back by opening
		     this scheme; with no entry here iOS has nothing registered to open,
		     the session closes with no result, and authenticate() fails with a
		     bare "canceled" that looks exactly like the user tapping Cancel.

		     The value is REVERSED_CLIENT_ID from ios/Runner/GoogleService-Info.plist
		     verbatim (that file's CLIENT_ID reversed). It has to be literal:
		     Info.plist cannot read another plist at build time. If the Firebase
		     iOS app is ever recreated, its CLIENT_ID changes and this string
		     must be updated with it.

		     Note the plugin itself does NOT need a GIDClientID key here: with no
		     clientId passed from Dart, FLTGoogleSignInPlugin falls back to
		     reading CLIENT_ID out of GoogleService-Info.plist, which is already
		     in the bundle. Only this URL scheme is missing. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.googleusercontent.apps.googlesignin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.508215311979-qrr5nrjcl6til44peg3k3jmdv0smub7e</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>GrowDaily uses your location to calculate accurate prayer times for your reminders. Your coordinates are sent to a prayer-time service, and if you are signed in they are saved to your account so reminders follow you across devices.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>GrowDaily uses your microphone to record short voice notes you attach to tasks. If you are signed in, your notes are saved to your private GrowDaily account so they sync across your devices.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>GrowDaily reads your daily step count from Apple Health (including steps recorded by your Apple Watch) so walking habits you link to steps can complete themselves automatically. Steps are only read, never changed, and stay on your device.</string>
	<!-- Required by App Store validation (error 90683) whenever the HealthKit
	     entitlement is present, even for an app that only ever reads: the
	     entitlement PERMITS writing, so Apple asks for the string regardless.
	     Build 69 was refused for its absence on 2026-09-10. The wording says
	     plainly that nothing is written, because that is the truth and it is
	     what somebody reading the sheet wants to know. -->
	<key>NSHealthUpdateUsageDescription</key>
	<string>GrowDaily never writes anything to Apple Health. It only reads your step count, so nothing you see in Health is changed or added by this app.</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>GrowDaily rings an alarm for the habits and tasks you choose to be woken for, even when your iPhone is on silent or in a Focus. Only reminders you switch to alarm use this.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIStatusBarHidden</key>
	<false/>
	<!-- Portrait only, matching main.dart's setPreferredOrientations lock.
	     These used to allow landscape while the Dart side forbade it, so
	     the plist and the app disagreed: iOS consults this BEFORE main()
	     runs, which meant launching a device held sideways drew the launch
	     screen rotated and then snapped upright. The ~ipad array is kept
	     and kept portrait rather than deleted: this ships as an
	     iPhone-only binary (TARGETED_DEVICE_FAMILY = 1), so it still runs
	     on iPad in compatibility mode, and an array left declaring all
	     four orientations would quietly reintroduce landscape there. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
