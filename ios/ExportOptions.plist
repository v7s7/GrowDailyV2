<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>DSHFS6NXFM</string>
	<!-- Manual, not automatic, since 2026-09-03. Automatic export needs an
	     Apple ID signed into Xcode to fetch a profile, and this Mac has none
	     (Xcode > Settings > Accounts is empty), which is what blocked the
	     first build-65 attempt after HealthKit was added to the App ID.
	     Both profiles below were created on developer.apple.com and are
	     installed in ~/Library/MobileDevice/Provisioning Profiles/.
	     They expire 2027/03/01 and must be regenerated by hand before then,
	     or any time a capability is added to either App ID.
	     Debug and Profile configurations are still Automatic, so day-to-day
	     simulator and device builds are unaffected. -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.growdaily.v2</key>
		<string>GrowDaily AppStore</string>
		<key>com.growdaily.v2.GrowDailyWidget</key>
		<string>GrowDailyWidget AppStore</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
