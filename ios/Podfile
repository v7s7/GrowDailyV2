# Firebase Analytics WITHOUT the advertising identifier.
#
# firebase_analytics defaults to the GoogleAppMeasurement variant that links
# IdentitySupport and GoogleAdsOnDeviceConversion, which reference
# ASIdentifierManager and put the IDFA in the binary. This app does no
# advertising and no tracking: ios/Runner/PrivacyInfo.xcprivacy declares
# NSPrivacyTracking false, there is no NSUserTrackingUsageDescription, and the
# published privacy policy says diagnostics are never used for advertising.
#
# Shipping the default variant would make all three of those statements false
# about the actual binary, and App Store Connect detects IDFA linkage at
# upload: answering its advertising identifier question truthfully then
# contradicts a build with no ATT prompt, which is a 5.1.2 rejection.
#
# This flag must sit ABOVE every other line, because CocoaPods reads it while
# resolving the podspec. First party analytics is unaffected.
$FirebaseAnalyticsWithoutAdIdSupport = true

# 15.0, not just the 13.0 purchases_flutter itself needs - the hosted
# Paywall/Customer Center UI (purchases_ui_flutter, RevenueCatUI - see
# PurchaseService) only renders on iOS 15.0+; older devices would silently
# get nothing if this stayed at 13.0. Explicit rather than relying on
# Flutter's own default deployment target, so this doesn't silently drift
# on a future `flutter create`/template update. Trade-off: drops iOS 13/14
# support, a vanishingly small slice of the install base by mid-2026.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
