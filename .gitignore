# Code generation (commit these after running build_runner)
# *.g.dart
# *.freezed.dart

# Symbols / obfuscation
app.*.symbols
app.*.map.json

# Android build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# Environment / secrets
.env
*.env.local

# Firebase — commit firebase_options.dart once generated by flutterfire CLI
# .firebase/ holds per-deploy hosting caches, regenerated by every
# `firebase deploy`. Machine-local build artifact, never source.
.firebase/

# Admin lookup tool (scripts/admin_lookup) — the service account key grants
# full read/write access to the whole Firebase project, and the generated
# reports are full personal data dumps of real users. Neither ever belongs
# in git.
scripts/admin_lookup/service-account.json
scripts/admin_lookup/reports/
scripts/admin_lookup/node_modules/

# Cloud Functions (functions/) — installed fresh by `npm install` before
# every deploy, same reasoning as scripts/admin_lookup/node_modules/ above.
functions/node_modules/
