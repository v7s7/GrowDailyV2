{
  "flutter": {
    "platforms": {
      "ios": {
        "default": {
          "projectId": "grow-daily-339ef",
          "appId": "1:508215311979:ios:885d52f65de4c31e1fbb2e",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "grow-daily-339ef",
          "configurations": {
            "ios": "1:508215311979:ios:885d52f65de4c31e1fbb2e",
            "web": "1:508215311979:web:76e5b77a301b7e931fbb2e"
          }
        }
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "me-central2",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        "test",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": [
    {
      "target": "site",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/node_modules/**",
        "**/.DS_Store"
      ],
      "appAssociation": "NONE",
      "rewrites": [
        {
          "source": "/join/**",
          "destination": "/join/index.html"
        },
        {
          "source": "/open",
          "destination": "/open/index.html"
        }
      ],
      "headers": [
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      ]
    },
    {
      "target": "app",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.DS_Store"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/@(index.html|flutter_bootstrap.js|flutter_service_worker.js|main.dart.js|version.json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}
