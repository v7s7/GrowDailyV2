rules_version = '2';

// GrowDaily — Firestore security rules
//
// Data model (all confirmed against the actual app code):
//   /users/{uid}                          — profile, XP, gold, streaks,
//                                            unlockedAchievements,
//                                            categoryCompletions
//   /users/{uid}/daily/{dateKey}           — daily habit completions, grid
//                                            activity, intentions, night
//                                            review mood + reflection text
//   /users/{uid}/custom_habits/{habitId}   — user-created habit templates
//   /users/{uid}/focus_plans/{dateKey}     — focus timer sessions
//   /users/{uid}/matrix_tasks/{taskId}     — Eisenhower matrix tasks
//   /users/{uid}/weekly_challenges/{weekKey}
//   /rooms/{roomId}                        — a group challenge (see below)
//   /rooms/{roomId}/participants/{uid}     — one member's progress in it
//
// Every document under /users/{uid} belongs to exactly one account and is
// never shared, so the rule is simple: you can only read/write your own
// tree, and nothing else exists in the database. /rooms/{roomId} is the one
// deliberate exception — it's read by every member, not just its owner, see
// its own match block below for why.
//
// One historical note: `premiumActive` used to live on this doc and this
// rule block (premiumFieldOk()) still stops a client from ever flipping it
// to true, but nothing writes it anymore. Premium entitlement is now owned
// entirely by RevenueCat (see PurchaseService's doc comment) - it verifies
// the App Store receipt directly with Apple on its own servers and tracks
// entitlement per App User ID (this account's Firebase uid, once signed
// in - see PurchaseService.logIn), not a field in this database at all.
// premiumFieldOk() is kept as harmless defense-in-depth (a stray write to
// `premiumActive` still can't grant Premium for free) rather than removed,
// since deleting a security rule is a change worth deploying deliberately,
// not as a side effect of the field going unused.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function premiumFieldOk() {
      let before = resource.data.premiumActive;
      let after = request.resource.data.premiumActive;
      return !('premiumActive' in request.resource.data)
          || after == before
          || after == false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && !('premiumActive' in request.resource.data);
      allow update: if isOwner(uid) && premiumFieldOk();
      // Account deletion (AuthNotifier.deleteAccount) deletes this doc
      // directly from the client after re-authenticating, so the owner
      // needs delete access here too.
      allow delete: if isOwner(uid);

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // A room is a multi-user group challenge (create/join by a short code
    // from Profile → Rooms) - the one place in this app where a document is
    // meant to be read by more than its own owner, so it can't reuse the
    // isOwner-only rule above. Knowing the code is what stands in for an
    // invite here: anyone signed in can read a room and its roster (there's
    // no way to discover a code except being told it), but can only ever
    // write their own participant entry.
    //
    // `get` vs `list`, deliberately split, not one `allow read`: Firestore
    // treats plain `allow read` as granting *both* a single-doc `get` (the
    // app's own access pattern - RoomsController always does
    // `.doc(code).get()`/`.snapshots()`, confirmed by grepping every
    // `collection('rooms')` call site, never a bare collection query) *and*
    // collection-level `list` (an unfiltered `collection('rooms').get()`).
    // A plain `allow read` would let any signed-in client - not just this
    // app's own UI, anyone hitting the same public Firebase config with
    // the SDK or REST API directly - enumerate every room ever created,
    // recovering each one's code (the document ID itself) plus its name,
    // schedule, and creator. That defeats the whole "the code is the
    // invite, and there's no way to discover one except being told it"
    // model this comment block used to describe as fact rather than
    // intent. `allow get` alone preserves every real access pattern above
    // (you still need to already know a code to fetch that one document)
    // while granting no `list` capability on this collection at all.
    match /rooms/{roomId} {
      allow get: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;
      // ── Who may change what on a room doc ──────────────────────────────
      // This used to be a bare `allow update: if isSignedIn()`, which meant
      // anyone who knew a code could rewrite that room outright - rename it,
      // move its end date, empty its shared plan, flip it back to a lobby -
      // not just the leader. The comment above it called that a per-field
      // rule "possible later"; this is that rule.
      //
      // Three legitimate writers, and nothing else:
      //
      //  1. The leader, who may change anything. Note this also covers
      //     leaveRoom's leadership handoff: the departing leader is still
      //     createdBy at the moment they write the successor in.
      //
      //  2. Any signed-in member touching ONLY memberCount - joinRoom
      //     increments it and leaveRoom decrements it, so it genuinely
      //     cannot be leader-only.
      //
      //  3. Any member's device flipping a SCHEDULED room out of its lobby
      //     once the moment has actually passed. This one looks like a hole
      //     and isn't: RoomsController.autoStartIfDue deliberately fires
      //     from whoever happens to be watching the countdown, because a
      //     room must start on time even if the leader's phone is off (see
      //     _LobbyCardState._onTick). The conditions below pin it to exactly
      //     that transition - lobby to active, only on a room that really
      //     had a scheduled start, only once request.time has passed it, and
      //     only touching the four fields _beginChallenge writes. It cannot
      //     be used to start a room early, restart a finished one, or change
      //     anything else along the way.
      //
      // Field lists are matched against RoomsController's actual writes; if
      // a new one is added there, it belongs here too or it will start
      // failing permission-denied.
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['memberCount'])
        || (
             resource.data.status == 'lobby'
             && request.resource.data.status == 'active'
             && resource.data.scheduledStartAt is timestamp
             && resource.data.scheduledStartAt <= request.time
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'startDate', 'scheduledStartAt', 'endDate'])
           )
      );
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /participants/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(uid);
        // A participant can always delete their own entry (leaving - see
        // RoomsController.leaveRoom). The room's own creator can also
        // delete *any* participant's entry, needed for
        // RoomsController.deleteRoom's full-room teardown, which removes
        // every member's doc, not just the leader's own - see that
        // method's doc comment for why plain isOwner(uid) alone isn't
        // enough for that to work.
        allow delete: if isOwner(uid) ||
            get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy
                == request.auth.uid;
      }
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
