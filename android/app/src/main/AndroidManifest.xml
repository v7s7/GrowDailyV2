<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase, the Aladhan prayer-time API, Open-Meteo geocoding,
         BigDataCloud reverse geocoding and RevenueCat all need the network.
         Declared here (not only in the debug manifest) so release builds
         have it too. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 13 (API 33) and up: notifications are a runtime permission.
         Without this declaration every habit reminder, prayer-time reminder
         and room push is silently dropped on a modern device. The runtime
         request itself is made from NotificationService.requestPermission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- flutter_local_notifications: reminders are scheduled in the future,
         so they must survive a reboot (RECEIVE_BOOT_COMPLETED) and be able
         to buzz (VIBRATE). No SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM here on
         purpose: every zonedSchedule call in notification_service.dart uses
         AndroidScheduleMode.inexactAllowWhileIdle, which needs no exact-alarm
         permission and avoids Play's restricted-permission declaration form
         entirely. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- geolocator, for the prayer-time auto-detect path
         (DeviceLocationService). Foreground only: there is no
         ACCESS_BACKGROUND_LOCATION here, matching the iOS Info.plist promise
         that the app "never tracks your location in the background". Adding
         it later would trigger Play's background-location review. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- record, for the Tasks voice notes (VoiceNoteService). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- health, read-only steps from Health Connect so a linked walking
         habit can complete itself (HealthStepsService). READ_STEPS is the
         only health permission: nothing is written and nothing else is
         read, keeping the Play Data safety form to a single row. -->
    <uses-permission android:name="android.permission.health.READ_STEPS"/>

    <!-- Advertising ID, REMOVED on purpose.
         firebase_analytics pulls in play-services-ads-identifier, which
         merges com.google.android.gms.permission.AD_ID into the manifest
         without this app ever asking for it (confirmed by dumping the built
         APK's badging, where the permission appeared alongside the ones
         declared above).
         Carrying it means declaring advertising-ID collection on Play's
         Data safety form and keeping the privacy policy consistent with
         that, all to enable ad attribution this app does not use and does
         not sell. Analytics itself keeps working without it: only
         ad-ID-linked audiences and attribution are lost.
         tools:node="remove" strips it at manifest-merge time. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- The Privacy Sandbox half of the same thing, also merged in by
         firebase_analytics (via androidx.privacysandbox.ads:ads-adservices).
         Removing only the GMS AD_ID permission above is NOT enough: a build
         with just that removed still declared
         android.permission.ACCESS_ADSERVICES_AD_ID, so the app would still
         have been requesting an advertising identifier while the Play Data
         safety form said it collects none. Verified by dumping the built
         APK's badging both before and after. -->
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <!-- HARDWARE, ALL OPTIONAL.
         Play reads permissions as implied hardware requirements and filters
         the app off any device that lacks them, silently: ACCESS_FINE_LOCATION
         implies android.hardware.location, RECORD_AUDIO implies
         android.hardware.microphone, and an implied feature defaults to
         required="true". Confirmed by dumping the built APK:

           uses-implied-feature: name='android.hardware.location'
             reason='requested android.permission.ACCESS_COARSE_LOCATION
             permission, and requested android.permission.ACCESS_FINE_LOCATION
             permission'
           uses-implied-feature: name='android.hardware.microphone'
             reason='requested android.permission.RECORD_AUDIO permission'

         Neither is anywhere near required to USE this app. Location is one of
         two ways to set the prayer-time city and the other is a plain search
         box (CitySearchSheet); the microphone is for a task's optional voice
         note. Both already degrade on their own — DeviceLocationService
         returns null on any failure, and VoiceNoteService.start no-ops when
         hasPermission() is false — so a device without either loses one
         optional path and nothing else, which is not a reason to hide the
         whole app from it.

         Declaring them explicitly with required="false" is the only way to
         say so; a permission cannot be qualified on its own. -->
    <uses-feature android:name="android.hardware.location" android:required="false"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>
    <uses-feature android:name="android.hardware.location.network" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <!-- android:label is "Grow Daily" with the space, matching
         CFBundleDisplayName in ios/Runner/Info.plist, the Play Store
         listing, and the wordmark the app itself renders. This is the
         string Android shows under the launcher icon and inside the
         notification permission dialog, so a different spelling here is a
         visible brand split. -->
    <application
        android:label="Grow Daily"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- growdaily://... - the LEGACY scheme. Still declared because
                 links shared before invites moved to https are sitting in
                 people's chat histories, and because the home screen widget's
                 own growdaily://matrix/add link never leaves the device and
                 has no reason to be a web URL (see
                 lib/core/constants/deep_links.dart's legacyScheme). Mirrors
                 ios/Runner/Info.plist's CFBundleURLSchemes. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="growdaily"/>
            </intent-filter>

            <!-- Android App Links: the https room invite.
                 https://grow-daily-339ef.web.app/join/CODE is what
                 roomShareMessage actually shares now (see
                 lib/core/constants/deep_links.dart) — a real URL, because
                 messengers only auto-linkify http/https and the old custom
                 scheme arrived as untappable grey text with no fallback for
                 anyone who did not have the app yet.

                 iOS got the matching half of that change (the AASA in
                 public/.well-known/ and the associated-domains entitlement)
                 and Android did not, so every invite opened a browser and
                 the app was never offered the link at all. This is the
                 Android half.

                 THREE THINGS MUST AGREE, exactly as the iOS comment says of
                 its own three:
                   1. this filter's host and pathPrefix,
                   2. public/.well-known/assetlinks.json, served from that
                      same host as application/json,
                   3. what roomJoinUrl() builds.

                 autoVerify="true" makes Android fetch assetlinks.json at
                 install time and, on a match, hand the link straight to the
                 app with no chooser. On a MISMATCH it does not fail loudly:
                 the app simply stops being offered, and the link opens the
                 browser again — the same silent degradation the iOS side
                 documents. Verify a build with
                 `adb shell pm get-app-links com.growdaily.v2`.

                 pathPrefix, not a bare host: the host also serves the privacy
                 policy, the support page and the /join fallback web page, and
                 nothing but an invite should pull the app forward. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="grow-daily-339ef.web.app"
                    android:pathPrefix="/join"/>
                <!-- The password-reset link out of Firebase's email. Same
                     three-way agreement as /join above: this prefix, the
                     AASA/assetlinks pair on that host, and what
                     parsePasswordResetLink accepts. Without it the link
                     opens public/reset/index.html in a browser, which still
                     works but is the long way round. -->
                <data
                    android:scheme="https"
                    android:host="grow-daily-339ef.web.app"
                    android:pathPrefix="/reset"/>
            </intent-filter>

            <!-- Health Connect shows the app's permission rationale through
                 this intent (Android 13 and below use the androidx action,
                 14+ goes through the activity-alias below). Both roads lead
                 back into the app, and MainActivity.maybeShowPrivacyPolicy
                 is what makes them arrive somewhere: declaring the filter
                 without handling the action put anyone who tapped "privacy
                 policy" inside Health Connect's own sheet on the habit grid
                 instead. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>

        <!-- Android 14+ Health Connect permission-rationale entry point;
             the activity-alias form is what the health package documents. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>

        <!-- flutter_local_notifications' own components. The plugin's AAR
             ships NONE of these: its library manifest
             (~/.pub-cache/.../flutter_local_notifications-18.0.1/android/src/
             main/AndroidManifest.xml) contains two <uses-permission> lines and
             no <application> block at all, so nothing is merged in and the
             app has to declare them by class name. Its README says so
             directly ("Specify the following between the <application> tags
             so that the plugin can actually show the scheduled
             notification(s)").

             Without them the failure is silent and total, which is why it
             survived this long: zonedSchedule succeeds, the AlarmManager
             entry is created, the alarm fires, and Android finds no
             component registered to receive the broadcast, so the
             notification is simply never posted. Nothing throws, nothing
             logs, and the Dart side has no way to tell. Verified against the
             built manifest before this change:
             build/app/intermediates/packaged_manifests/debug/.../
             AndroidManifest.xml contained zero com.dexterous entries.

             All three are android:exported="false" — they are only ever
             triggered by the plugin's own PendingIntents and by the system
             broadcasts named below, so nothing outside the app has any
             business reaching them. -->

        <!-- Posts a scheduled notification when its alarm fires. This is the
             one that makes every habit reminder, quit check-in and task
             reminder actually appear. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>

        <!-- Re-arms everything after a restart. AlarmManager entries do not
             survive a reboot, and neither does an app update that replaces
             the package, so without this a phone restarted at night loses
             every armed reminder — including the whole multi-day window
             NotificationService arms ahead (see kOccurrencesPerSlot) — until
             the app is opened again. RECEIVE_BOOT_COMPLETED is already
             declared above; the permission alone does nothing without a
             receiver listening for the broadcast.

             QUICKBOOT_POWERON and its HTC spelling are the OEM fast-boot
             equivalents some devices send INSTEAD of BOOT_COMPLETED; they
             cost nothing and are what the plugin's own example declares. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Delivers a tap on a notification's action BUTTON, for the
             BACKGROUND kind only.

             Not currently on any path this app takes, and declared anyway.
             Every Android action here is built with showsUserInterface: true
             (see NotificationService's _habitReminderDetails), and the plugin
             branches on exactly that: showsUserInterface true builds a launch
             intent for MainActivity, false builds an Intent for this receiver
             (FlutterLocalNotificationsPlugin.java:302-310). So «تمت» and
             «تأجيل ساعة» reach the app through the activity today and this
             component is never used.

             It stays because the moment anyone gives Android the background
             actions iOS already has — marking a habit done from the shade
             without the app coming forward, which is what
             notification_action_background.dart exists for — the buttons
             would silently do nothing without it, and nothing in the Dart
             code would hint at why. One line now, or an afternoon later. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false"/>

        <!-- The status-bar icon for every notification. Android draws this as
             a pure alpha mask, so a full-colour @mipmap/ic_launcher renders as
             a solid grey/white blob; ic_notification is the flat white
             silhouette drawn from the app mark. Matches the
             AndroidInitializationSettings value in notification_service.dart. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification"/>
        <!-- Brand cream, the same colour the splash and iOS build use. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color"/>
        <!-- Routes FCM messages that arrive with no explicit channel into the
             same channel flutter_local_notifications creates, so a room push
             and a habit reminder share one entry in Android's per-channel
             notification settings instead of appearing as two. Must stay in
             sync with _channelId in notification_service.dart — which is why
             this string carries the same _v2 the Dart constant does: an
             Android channel's importance is frozen at creation, so raising
             reminders from IMPORTANCE_DEFAULT (no heads-up banner, ever) to
             IMPORTANCE_HIGH needed a new id, and a stale value here would
             quietly send every room push to a channel the app deletes at
             launch. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="growdaily_reminders_v2"/>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Lets the health package check whether the Health Connect app is
             installed before offering to link a walking habit to steps. -->
        <package android:name="com.google.android.apps.healthdata"/>
    </queries>
</manifest>
